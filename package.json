{
    "name": "modular-node-starter",
    "version": "1.0.0",
    "description": "Modular Monolithic Node.js backend using Express.js, TypeScript, and Prisma",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
        "start": "node dist/server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "express",
        "typescript",
        "prisma",
        "modular-monolith"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@prisma/adapter-pg": "^7",
        "@prisma/client": "^7",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^4.22.2",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^8.5.2",
        "handlebars": "^4.7.9",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "nodemailer": "^8.0.10",
        "pg": "^8.16.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^25.9.1",
        "@types/nodemailer": "^8.0.0",
        "@types/pg": "^8.11.11",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.4.2",
        "prettier": "^3.8.3",
        "prisma": "^7",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.8.17",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/maniecodes/modular-node-starter.git"
    },
    "type": "commonjs",
    "types": "./dist/server.d.ts",
    "bugs": {
        "url": "https://github.com/maniecodes/modular-node-starter/issues"
    },
    "homepage": "https://github.com/maniecodes/modular-node-starter#readme"
}